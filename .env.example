PORT=3001
HOST=127.0.0.1
# Use a public HTTPS origin and HOST=0.0.0.0 when deploying behind a proxy.
PUBLIC_ORIGIN=http://localhost:3001
# Optional notification transport. Enquiries are saved even without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_EMAIL=
# WhatsApp Business Cloud API. Create and approve the named templates in Meta
# WhatsApp Manager before enabling these values. Numbers include country code.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_TEAM_TEMPLATE=
WHATSAPP_WELCOME_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v24.0
