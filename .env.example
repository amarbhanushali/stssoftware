PORT=3001
HOST=127.0.0.1
# Use a public HTTPS origin and HOST=0.0.0.0 when deploying behind a proxy.
PUBLIC_ORIGIN=http://localhost:3001
# Number of reverse proxies in front of Node (Caddy/Nginx/Hostinger = 1).
# Required in production so rate limits apply per visitor, not per proxy.
TRUST_PROXY=0
# Optional Google Search Console HTML-tag verification value (the value only).
GOOGLE_SITE_VERIFICATION=
# Optional Google Analytics 4 Measurement ID, for example G-ABCDEFGHIJ.
GOOGLE_ANALYTICS_ID=
# Optional notification transport. Enquiries are saved even without SMTP.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=full Gmail address,
# SMTP_PASS=16-character App Password (not the normal password), MAIL_FROM=same
# Gmail address. Check with: npm run mail:test
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Inbox that receives new enquiries (the public address is sales@stssoftware.in).
NOTIFY_EMAIL=
# Optional acknowledgement email sent automatically to every valid enquiry.
AUTO_REPLY_EMAIL_SUBJECT=We received your enquiry | Samarth Tech Software
# WhatsApp Business Cloud API. Create and approve the named templates in Meta
# WhatsApp Manager before enabling these values. Numbers include country code.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_TEAM_TEMPLATE=
WHATSAPP_WELCOME_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v24.0
# AI enquiry chat assistant (OpenAI). Leave the key empty to hide the chat.
# The key is used only on the server and is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# HubSpot CRM: every enquiry becomes a contact (lead status "New") with the
# enquiry saved as a note. Create a Private App in HubSpot (Settings >
# Integrations > Private Apps) with scopes crm.objects.contacts.read and
# crm.objects.contacts.write, and paste its access token here.
HUBSPOT_ACCESS_TOKEN=
# Automatic follow-up email asking service-specific questions, sent this many
# hours after an enquiry (1-23), during 09:00-20:00 IST only. Leave empty to
# turn off. Skipped if the lead's status in HubSpot is no longer "New".
FOLLOWUP_DELAY_HOURS=
