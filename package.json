{
  "name": "samarth-tech-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env server/index.mjs\" \"vite\"",
    "build": "vite build && vite build --ssr server/render.jsx --outDir server/rendered",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "enquiries": "node --env-file-if-exists=.env scripts/enquiries.mjs",
    "test": "node --test tests/api.test.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "format": "prettier --write src server/index.mjs server/render.jsx scripts/enquiries.mjs tests/*.mjs vite.config.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
